<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GraphBuilder.UI.ViewModels"
        xmlns:controls="using:GraphBuilder.UI.Controls"
        x:Class="GraphBuilder.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Graph Builder"
        Width="1280"
        Height="720">

	<Design.DataContext>
		<vm:MainWindowViewModel />
	</Design.DataContext>

	<DockPanel>
		<!-- Top header -->
		<Panel DockPanel.Dock="Top" Background="rgba(122, 122, 122, 1)" Height="50">
			<TextBlock Text="Desmos Clone"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,10"
                       Foreground="rgba(255, 255, 255, 1)"
                       FontFamily="JetBrains Mono"/>

			<StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,45,0,0"
                        Spacing="10">
			</StackPanel>
		</Panel>

		<!-- Left side panel -->
		<Border DockPanel.Dock="Left"
                Width="220"
                Background="rgba(223, 223, 223, 1)"
                Padding="10">
			<StackPanel>
				<TextBlock Text="Functions List"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Left"
                           Margin="0,10,0,10"
                           FontFamily="JetBrains Mono"
                           Foreground="#000000"/>

				<!-- Error message display -->
				<Border Background="#FFF44336"
                        CornerRadius="4"
                        Padding="5"
                        Margin="0,0,0,10"
                        Visibility="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
					<TextBlock Text="{Binding ErrorMessage}"
                               Foreground="White"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               FontSize="12"/>
				</Border>

				<TextBox Width="200"
                         Watermark="Enter function (e.g., x^2 + sin(x))"
                         Foreground="#000000"
                         Text="{Binding CurrentExpression}"
                         Margin="0, 0, 0, 10" />

				<Button Content="Plot Graph"
                        Command="{Binding ButtonCommand}"
                        Foreground="#000000"
                        Margin="0,0,0,20"/>

				<!-- Saved functions list -->
				<TextBlock Text="Saved Functions:"
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,5"
                           FontFamily="JetBrains Mono"
                           Foreground="#000000"/>

				<ListBox ItemsSource="{Binding Functions}"
                         MaxHeight="400"
                         Background="Transparent"
                         BorderThickness="0">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal"
                                        Margin="0,2">
								<Rectangle Width="12"
                                           Height="12"
                                           Fill="{Binding Color}"
                                           Margin="0,0,5,0"
                                           VerticalAlignment="Center"/>
								<TextBlock Text="{Binding Expression}"
                                           FontFamily="JetBrains Mono"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</StackPanel>
		</Border>

		<!-- Main drawing area -->
		<Border Background="White">
			<controls:CoordinatePlane
                Points="{Binding Points}"
                Scale="40"
                Offset="10, 10"/>
		</Border>
	</DockPanel>
</Window>