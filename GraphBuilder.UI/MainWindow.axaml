<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GraphBuilder.UI.ViewModels"
        xmlns:controls="using:GraphBuilder.UI.Controls"
        xmlns:converters="using:Avalonia.Data.Converters"
        x:Class="GraphBuilder.UI.MainWindow"
        Title="Graph Builder"
        Width="1280"
        Height="720">

	<Design.DataContext>
		<vm:MainWindowViewModel />
	</Design.DataContext>

	<Window.Resources>
		<converters:StringIsNotNullOrEmptyConverter x:Key="StringIsNotNullOrEmptyConverter" />
	</Window.Resources>

	<DockPanel>
		<!-- Top header -->
		<Panel DockPanel.Dock="Top" Background="rgba(122, 122, 122, 1)" Height="50">
			<TextBlock Text="Graph Builder"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,10"
                       Foreground="rgba(255, 255, 255, 1)"
                       FontFamily="JetBrains Mono"/>
		</Panel>

		<!-- Left side panel -->
		<Border DockPanel.Dock="Left"
                Width="220"
                Background="rgba(223, 223, 223, 1)"
                Padding="10">
			<StackPanel>
				<TextBlock Text="Functions"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Left"
                           Margin="0,10,0,10"
                           FontFamily="JetBrains Mono"
                           Foreground="#000000"/>

				<!-- Error message display -->
				<Border Background="#FFF44336"
                        CornerRadius="4"
                        Padding="5"
                        Margin="0,0,0,10"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static converters:StringIsNotNullOrEmptyConverter.Instance}}">
					<TextBlock Text="{Binding ErrorMessage}"
                               Foreground="White"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               FontSize="12"/>
				</Border>

				<TextBox Width="200"
                         Watermark="Enter function (e.g., x^2 + sin(x))"
                         Foreground="#000000"
                         Text="{Binding CurrentExpression}"
                         Margin="0, 0, 0, 10" />

				<Button Content="Plot"
                        Command="{Binding ButtonCommand}"
                        Foreground="#000000"/>

				<ListBox ItemsSource="{Binding Functions}"
                         MaxHeight="500"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,20,0,0">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Expression}"
                                       FontFamily="JetBrains Mono"
                                       FontSize="12"
                                       Margin="0,2"/>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</StackPanel>
		</Border>

		<!-- Main drawing area -->
		<Border Background="White">
			<controls:CoordinatePlane
                Points="{Binding Points}" />
		</Border>
	</DockPanel>
</Window>