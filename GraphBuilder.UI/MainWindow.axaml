<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GraphBuilder.UI.ViewModels"
        xmlns:controls="using:GraphBuilder.UI.Controls"
        x:Class="GraphBuilder.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Graph Builder"
        Width="1280"
        Height="720">
    
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    
    <DockPanel>
        <!-- Top header -->
        <Panel DockPanel.Dock="Top" Background="rgba(122, 122, 122, 1)" Height="50">
            <TextBlock Text="中国Desmos"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,10"
                       Foreground="rgba(255, 255, 255, 1)"
                       FontFamily="JetBrains Mono"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,45,0,0"
                        Spacing="10">
            </StackPanel>
        </Panel>

        <!-- Left side panel -->
        <Border DockPanel.Dock="Left"
                Width="220"
                Background="rgba(223, 223, 223, 1)"
                Padding="10">
            <StackPanel>
                <TextBlock Text="Список функций"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Left"
                           Margin="0,10,0,10"
                           FontFamily="JetBrains Mono"
                           Foreground="#000000"/>
                           
                <TextBox Width="200"
                         Watermark="Введите функцию"
                         Foreground="#000000"
                         Text="{Binding CurrentExpression}"                        
                         Margin="0, 0, 0, 10" />
                <Button Content="Посчитать"
                        Command="{Binding ButtonCommand}"
                        Foreground="#000000"/>
            </StackPanel>
        </Border>

        <!-- Main drawing area -->
        <Border Background="White">
            <controls:CoordinatePlane 
                Points="{Binding Points}" />
        </Border>
    </DockPanel>

</Window>