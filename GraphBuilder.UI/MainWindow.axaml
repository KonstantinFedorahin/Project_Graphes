<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GraphBuilder.UI.ViewModels"
        xmlns:controls="using:GraphBuilder.UI.Controls"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        x:Class="GraphBuilder.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Graph Builder"
        Width="1280"
        Height="720">

	<Design.DataContext>
		<vm:MainWindowViewModel />
	</Design.DataContext>

	<DockPanel>
		<!-- Top header -->
		<Panel DockPanel.Dock="Top" Background="rgba(122, 122, 122, 1)" Height="50">
			<TextBlock Text="Graph Builder"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,10"
                       Foreground="rgba(255, 255, 255, 1)"
                       FontFamily="JetBrains Mono"/>
		</Panel>

		<!-- Left side panel -->
		<Border DockPanel.Dock="Left"
                Width="220"
                Background="rgba(223, 223, 223, 1)"
                Padding="10">
			<StackPanel>
				<TextBlock Text="Function List"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Left"
                           Margin="0,10,0,10"
                           FontFamily="JetBrains Mono"
                           Foreground="#000000"/>

				<!-- Error Message Display - Option 1: Binding to Visibility -->
				<Border Background="#FFCDD2"
                        Padding="8"
                        Margin="0,0,0,10"
                        CornerRadius="4"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
					<TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#D32F2F"
                               FontSize="12"
                               TextWrapping="Wrap"/>
				</Border>

				<!-- Function Input -->
				<TextBox Width="200"
                         Watermark="Enter function (e.g., x^2, sin(x), 5)"
                         Foreground="#000000"
                         Text="{Binding CurrentExpression}"
                         Margin="0,0,0,10" />

				<!-- Calculate Button -->
				<Button Content="Calculate"
                        Command="{Binding ButtonCommand}"
                        Foreground="#000000"
                        Margin="0,0,0,10"/>

				<!-- Function List -->
				<TextBlock Text="Saved Functions:"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,10,0,5"/>

				<ListBox ItemsSource="{Binding Functions}"
                         Height="200">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Expression}"
                                       Margin="2"/>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</StackPanel>
		</Border>

		<!-- Main drawing area -->
		<Border Background="White"
                        ClipToBounds="True">
			<controls:CoordinatePlane
                                Graphs="{Binding Graphs}" 
                                Background="White"/>
		</Border>
	</DockPanel>
</Window>