<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GraphBuilder.UI.ViewModels"
        x:Class="GraphBuilder.UI.MainWindow"
        Title="Graph Builder"
        Width="800"
        Height="600">
    
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    
    <Grid RowDefinitions="Auto, *">
        <Panel Background="Bisque">
            <TextBlock Text="中国Desmos" FontSize="24" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" FontFamily="Courier New"/>
            <!-- Панель управления -->
            <Border Padding="0, 0, 0, 10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Orientation="Horizontal" Margin="0, 40, 0, 0" Spacing="10">
                    <TextBox Watermark="Введите функцию (например: x^2)" Width="200" />
                    <Button Content="Добавить" />
                </StackPanel>
            </Border>
        </Panel>
        <!-- Область рисования -->
        <Canvas Grid.Row="1" Background="BlanchedAlmond" Name="DrawingCanvas" />
    </Grid>
</Window>